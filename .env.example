# Nothing is required. The Supabase project URL and its publishable key have
# defaults in lib/supabase/config.ts: neither is a secret, and what a request
# may do is decided by the database from the visitor's own session.
#
# Override only to point at another project:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Offline development without Supabase: store everything in a JSON file.
LOCAL_STORE=
LOCAL_DATA_DIR=

# Optional: a MapLibre style.json for the basemap.
NEXT_PUBLIC_MAP_STYLE=

# Stage 2 (audit drafts): the Claude API key for the server route that writes
# the proposed public note. Server-only; never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
