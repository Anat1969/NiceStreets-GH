# Staff access code for the admin dashboard (/admin). Required in production.
STAFF_CODE=change-me

# Durable storage. When both are set the app stores everything in Supabase
# instead of the local JSON file used for development.
# The key is read on the server only and is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a MapLibre style.json for the basemap. Leave empty to use the
# default keyless OpenStreetMap basemap.
NEXT_PUBLIC_MAP_STYLE=

# Optional: where the local JSON store writes when Supabase is not configured.
LOCAL_DATA_DIR=
