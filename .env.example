# Staff access code for the admin dashboard (/admin). Required in production.
STAFF_CODE=change-me

# Optional: when both are set, the app stores data in Supabase instead of the
# local JSON store used for development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
